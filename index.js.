const express = require("express");
const crypto = require("crypto");
const {
  Client,
  GatewayIntentBits,
  EmbedBuilder,
  PermissionsBitField
} = require("discord.js");

const app = express();

const {
  DISCORD_TOKEN,
  CHANNEL_ID,
  GITHUB_WEBHOOK_SECRET,
  PORT = 3000
} = process.env;

if (!DISCORD_TOKEN || !CHANNEL_ID || !GITHUB_WEBHOOK_SECRET) {
  console.error("Missing required environment variables.");
  process.exit(1);
}

const client = new Client({
  intents: [GatewayIntentBits.Guilds]
});

app.get("/", (req, res) => {
  res.send("JJUPDATE is online.");
});

app.get("/health", (req, res) => {
  res.json({ status: "online" });
});

app.post(
  "/github",
  express.raw({ type: "application/json" }),
  async (req, res) => {
    const signature = req.headers["x-hub-signature-256"];
    const event = req.headers["x-github-event"];

    if (!signature || !Buffer.isBuffer(req.body)) {
      return res.status(401).send("Unauthorized");
    }

    const expected =
      "sha256=" +
      crypto
        .createHmac("sha256", GITHUB_WEBHOOK_SECRET)
        .update(req.body)
        .digest("hex");

    const suppliedBuffer = Buffer.from(signature);
    const expectedBuffer = Buffer.from(expected);

    if (
      suppliedBuffer.length !== expectedBuffer.length ||
      !crypto.timingSafeEqual(suppliedBuffer, expectedBuffer)
    ) {
      return res.status(401).send("Invalid signature");
    }

    if (event !== "release") {
      return res.status(200).send("Event ignored");
    }

    let payload;

    try {
      payload = JSON.parse(req.body.toString("utf8"));
    } catch {
      return res.status(400).send("Invalid JSON");
    }

    if (
      payload.action !== "published" ||
      payload.release?.draft ||
      payload.release?.prerelease
    ) {
      return res.status(200).send("Not a published stable release");
    }

    try {
      const channel = await client.channels.fetch(CHANNEL_ID);

      if (!channel || !channel.isTextBased()) {
        throw new Error("Announcement channel not found.");
      }

      const release = payload.release;
      const version = release.tag_name || "New Release";
      const repository = payload.repository?.full_name || "GitHub";
      const changelog =
        release.body?.trim() || "No changelog was provided.";

      const embed = new EmbedBuilder()
        .setColor(0xE8A6C8)
        .setTitle(`${repository} — ${version} Update`)
        .setDescription(changelog.slice(0, 4000))
        .addFields(
          {
            name: "Version",
            value: version.slice(0, 100),
            inline: true
          },
          {
            name: "Release",
            value: `[View on GitHub](${release.html_url})`,
            inline: true
          }
        )
        .setFooter({ text: "JJSTUDIOS • Automatic Update System" })
        .setTimestamp(new Date());

      await channel.send({
        content: "@everyone",
        embeds: [embed],
        allowedMentions: { parse: ["everyone"] }
      });

      console.log(`Published ${repository} ${version}`);
      return res.status(200).send("Announcement published");
    } catch (error) {
      console.error("Announcement failed:", error);
      return res.status(500).send("Announcement failed");
    }
  }
);

client.once("clientReady", () => {
  console.log(`JJUPDATE online as ${client.user.tag}`);

  app.listen(PORT, () => {
    console.log(`Webhook server listening on port ${PORT}`);
  });
});

client.login(DISCORD_TOKEN);

